{
  "name": "print-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/bootstrap.ts && next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "test:e2e:pooled": "tsx scripts/e2e-pooled.ts",
    "test:e2e:live": "playwright test --grep @smoke",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "user:set-password": "tsx scripts/set-password.ts",
    "verify": "tsx scripts/verify.ts",
    "db:bootstrap": "tsx scripts/bootstrap.ts --force",
    "db:restore": "tsx scripts/restore.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@vercel/blob": "^2.9.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fast-check": "^4.11.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@node-rs/argon2"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
