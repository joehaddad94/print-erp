# Copy to .env.local for local development. Never commit real values.
# In production these are set in Vercel → Project → Settings → Environment Variables.

# Supabase → Connect → "Transaction pooler" (port 6543). Used by the app.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/print_erp
# Supabase → Connect → "Session pooler" (port 5432). Used only by migrations at deploy.
DIRECT_URL=postgres://postgres:postgres@localhost:5432/print_erp
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# First run only: creates this user if none exists. Remove both after your first login.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Set automatically when a Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=
# private (default) or public: must match how the Blob store was created
BLOB_ACCESS=private
